# Copy to .streamlit/secrets.toml for local runs (it is git-ignored), or paste into
# Streamlit Cloud -> Manage app -> Settings -> Secrets. NEVER commit real values.
MUSARURO_AT_USERNAME = "sandbox"       # your Africa's Talking username; "sandbox" while testing
MUSARURO_AT_API_KEY = "paste-key-here"
MUSARURO_SMS_PIN = "choose-a-pin"      # the operator PIN typed in the app before a real send
MUSARURO_AT_SANDBOX = "1"              # remove when going live
# MUSARURO_AT_SENDER = "MUSARURO"      # only after the sender ID is approved
